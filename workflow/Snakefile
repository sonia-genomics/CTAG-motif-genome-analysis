# =========================================================
# 01 DOWNLOAD GENOMES
# =========================================================

rule download_data:

    input:
        "requirements/bacterial_genome.csv"

    output:
        directory("data/raw/genomes"),
        directory("data/raw/annotations")

    shell:
        """
        python scripts/01_download_data.py
        """


# =========================================================
# 02 GENOME QC
# =========================================================

